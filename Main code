local function startHDT(targetModelOrHRP)
    if not S.HDT_Enabled or hdtActive then return end
    local targetModel
    if targetModelOrHRP and targetModelOrHRP:IsA("BasePart") then
        targetModel=targetModelOrHRP:FindFirstAncestorOfClass("Model")
    else targetModel=targetModelOrHRP end
    if not targetModel or not targetModel.Parent then return end
    local initialHRP=getKillerHRP(targetModel); if not initialHRP then return end
    local hum=getMyHum(); local hrp=getMyHRP()
    if not hum or not hrp then return end
    local dist=(hrp.Position-initialHRP.Position).Magnitude
    if dist>(S.HDT_MaxDistance or 15) then return end
    if dist<=(S.HDT_StopDist or 2)+0.1 then return end
    if not lockAutoRotate() then return end
    hdtActive=true
    hdtTargetModel=targetModel
    hdtSavedWalk=hum.WalkSpeed; hdtSavedJump=hum.JumpPower
    hum.WalkSpeed=0; hum.JumpPower=0
    hdtBV=Instance.new("BodyVelocity")
    hdtBV.MaxForce=Vector3.new(100000,0,100000)
    hdtBV.Velocity=Vector3.zero; hdtBV.Parent=hrp
    local myHrp=hrp
    local speed=S.HDT_Speed or 10
    local stopDist=S.HDT_StopDist or 2
    hdtConn=RunService.Heartbeat:Connect(function()
        if not hdtActive then
            if hdtConn then hdtConn:Disconnect(); hdtConn=nil end
            return
        end
        if not hdtBV or not hdtBV.Parent then stopHDT("bv-gone") return end
        if not hdtTargetModel or not hdtTargetModel.Parent then stopHDT("target-gone") return end
        if not myHrp or not myHrp.Parent then stopHDT("no-hrp") return end
        local targetHRP=getKillerHRP(hdtTargetModel)
        if not targetHRP then stopHDT("no-target-hrp") return end
        local myPos=myHrp.Position; local tp=targetHRP.Position
        local dx,dz=tp.X-myPos.X,tp.Z-myPos.Z
        local magSq=dx*dx+dz*dz
        if magSq>1e-4 then
            local m=math.sqrt(magSq)
            hdtBV.Velocity=Vector3.new(dx/m*speed,0,dz/m*speed)
            myHrp.CFrame=CFrame.lookAt(myPos,Vector3.new(tp.X,myPos.Y,tp.Z))
        else hdtBV.Velocity=Vector3.zero end
        if (tp-myPos).Magnitude<=stopDist then stopHDT("contact") end
    end)
    hdtCapThread=task.delay(S.HDT_MaxTime or 0.4,function()
        hdtCapThread=nil
        if hdtActive then stopHDT("cap") end
    end)
end
