local lastBlockClock = 0
local function fireBlock()
    if os.clock() - lastBlockClock < 0.08 then return end
    lastBlockClock = os.clock()
    local re = ReplicatedStorage:FindFirstChild("Modules")
        and ReplicatedStorage.Modules:FindFirstChild("Network")
        and ReplicatedStorage.Modules.Network:FindFirstChild("Network")
        and ReplicatedStorage.Modules.Network.Network:FindFirstChild("RemoteEvent")
    if not re then return end
    pcall(function() re:FireServer("UseActorAbility", { "Block" }) end)
end

local function isFacing(localRoot, killerRoot)
    if not S.autoBlockFacing then return true end
    local dx = localRoot.Position.X - killerRoot.Position.X
    local dy = localRoot.Position.Y - killerRoot.Position.Y
    local dz = localRoot.Position.Z - killerRoot.Position.Z
    local mag = math.sqrt(dx*dx + dy*dy + dz*dz)
    if mag < 1e-4 then return true end
    local ux, uy, uz = dx/mag, dy/mag, dz/mag
    local lv = killerRoot.CFrame.LookVector
    return (lv.X*ux + lv.Y*uy + lv.Z*uz) > (S.autoBlockFacingThreshold or 0.3)
end

local spawnAntiFlick
local blockTracked = {}

local function trackKiller(model)
    if not model or blockTracked[model] then return end
    local hrp = getRoot(model)
    if not hrp then return end

    local conns = {}

    local function tryBlock(killerHrp)
        if not S.autoBlock then return end
        local myRoot = getRoot(LP.Character)
        if not myRoot or not killerHrp or not killerHrp.Parent then return end
        local dist = (myRoot.Position - killerHrp.Position).Magnitude
        if dist > S.autoBlockRange then return end
        if not isFacing(myRoot, killerHrp) then return end
        if S.autoBlockWall then
            local rp = RaycastParams.new()
            rp.FilterType = Enum.RaycastFilterType.Exclude
            rp.FilterDescendantsInstances = { LP.Character, model }
            if Workspace:Raycast(myRoot.Position, killerHrp.Position - myRoot.Position, rp) then return end
        end
        if S.autoBlockFaceOnBlock then
            myRoot.CFrame = CFrame.lookAt(myRoot.Position,
                Vector3.new(killerHrp.Position.X, myRoot.Position.Y, killerHrp.Position.Z))
        end
        fireBlock()
    end

    local function hookSound(s)
        if not s:IsA("Sound") then return end
        local function check()
            local id = tostring(s.SoundId):match("%d+")
            if id and DB.autoBlockSounds[id] and not BAD_SOUNDS[id] then
                tryBlock(hrp)
                if S.antiFlick and spawnAntiFlick then task.spawn(spawnAntiFlick, model) end
            end
        end
        conns[#conns+1] = s.Played:Connect(check)
        if s.IsPlaying then check() end
    end

    conns[#conns+1] = model.DescendantAdded:Connect(function(c) if c:IsA("Sound") then hookSound(c) end end)
    for _, d in ipairs(model:GetDescendants()) do if d:IsA("Sound") then hookSound(d) end end

    blockTracked[model] = function()
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    end
end

local function untrackAll()
    for k, fn in pairs(blockTracked) do pcall(fn) end
    blockTracked = {}
end

local killersFolder = Workspace:WaitForChild("Players"):WaitForChild("Killers")
local function refreshTracking()
    if not S.autoBlock then return end
    for _, k in ipairs(getKillers()) do trackKiller(k) end
end
killersFolder.ChildAdded:Connect(function(c) task.defer(function() if S.autoBlock then trackKiller(c) end end) end)
killersFolder.ChildRemoved:Connect(function(c)
    if blockTracked[c] then pcall(blockTracked[c]) blockTracked[c] = nil end
end)

-- AntiFlick motion tracker
local killerMotion = {}
local SMOOTH_LERP = 0.22
RunService.RenderStepped:Connect(function(dt)
    if not S.antiFlick then return end
    if dt <= 0 then return end
    for _, killer in ipairs(getKillers()) do
        local hrp = killer:FindFirstChild("HumanoidRootPart")
        if hrp then
            local st = killerMotion[killer]
            if not st then
                killerMotion[killer] = {
                    prevPos = hrp.Position, prevLook = hrp.CFrame.LookVector,
                    vel = Vector3.new(), angVel = 0,
                }
            else
                local newVel = (hrp.Position - st.prevPos) / math.max(dt, 1e-6)
                st.vel = st.vel:Lerp(newVel, SMOOTH_LERP)
                local prevLook, look = st.prevLook, hrp.CFrame.LookVector
                local dot = math.clamp(prevLook:Dot(look), -1, 1)
                local angle = math.acos(dot)
                local sign = prevLook:Cross(look).Y >= 0 and 1 or -1
                st.angVel = st.angVel * (1 - SMOOTH_LERP) + (angle / math.max(dt, 1e-6)) * sign * SMOOTH_LERP
                st.prevPos = hrp.Position
                st.prevLook = look
            end
        end
    end
end)

spawnAntiFlick = function(killer)
    if not killer or not killer.Parent then return end
    local hrp = getRoot(killer)
    local myRoot = getRoot(LP.Character)
    if not hrp or not myRoot then return end
    local st = killerMotion[killer] or { vel = hrp.AssemblyLinearVelocity, angVel = 0 }
    local vel = st.vel
    task.spawn(function()
        task.wait(S.antiFlickDelay)
        for i = 1, math.max(1, S.antiFlickParts) do
            if not hrp.Parent then return end
            local dist = S.antiFlickBaseOffset + (i-1) * 0.2
            local fwd = math.clamp(vel:Dot(hrp.CFrame.LookVector) * 0.25 * S.predStrength, -6*S.predStrength, 6*S.predStrength)
            local lat = math.clamp(vel:Dot(hrp.CFrame.RightVector) * 0.18 * S.predStrength, -4*S.predStrength, 4*S.predStrength)
            local turn = math.clamp(st.angVel * 0.6 * S.predTurnStrength, -4*S.predTurnStrength, 4*S.predTurnStrength)
            local spawnPos = hrp.Position
                + hrp.CFrame.LookVector * (dist + fwd)
                + hrp.CFrame.RightVector * (lat + turn)
            local part = Instance.new("Part")
            part.Name = "MSK_AntiFlickZone"
            part.Size = Vector3.new(5.5, 7.5, 8.5) * S.antiFlickSizeMult
            part.Material = Enum.Material.ForceField
            part.Transparency = 0.6
            part.Anchored = true
            part.CanCollide = false
            part.CFrame = CFrame.new(spawnPos, hrp.Position)
            part.BrickColor = BrickColor.new("Bright blue")
            part.Parent = Workspace
            game:GetService("Debris"):AddItem(part, 0.25)
            local rel = part.CFrame:PointToObjectSpace(myRoot.Position)
            local half = part.Size * 0.5
            if math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y and math.abs(rel.Z) <= half.Z then
                if S.autoBlock and isFacing(myRoot, hrp) then fireBlock() end
                return
            end
            if S.antiFlickStagger > 0 then task.wait(S.antiFlickStagger) else task.wait() end
        end
    end)
end

