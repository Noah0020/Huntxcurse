-- GENERATOR SOLVER
-- ============================================================
local genState = { enabled = false, speed = 1.5 }

local function doGenRepair()
    local myRoot = getRoot(LP.Character)
    if not myRoot then return end
    local ingame = Workspace:FindFirstChild("Ingame")
    local map = ingame and ingame:FindFirstChild("Map")
    if not map then return end
    for _, gen in ipairs(map:GetChildren()) do
        if gen.Name == "Generator" and gen:FindFirstChild("Progress") then
            local prog = gen.Progress
            if prog.Value < 100 then
                local main = gen:FindFirstChild("Main") or gen:FindFirstChild("Base")
                if main and (myRoot.Position - main.Position).Magnitude < 12 then
                    local remotes = gen:FindFirstChild("Remotes")
                    local re = remotes and (remotes:FindFirstChild("RE") or remotes:FindFirstChildWhichIsA("RemoteEvent"))
                    if re then pcall(function() re:FireServer() end) end
                end
            end
        end
    end
end

