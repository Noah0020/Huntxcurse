local lastBlockTime,lastParry=0,0
local BLOCK_COOLDOWN=0.15
local soundThrottle={}
local function tryBlock(killerModel,killerHRP,reason,soundKey)
    if not S.AutoBlock then return false end
    if not killerHRP or not killerHRP.Parent then return false end
    local now=os.clock()
    if now-lastBlockTime<BLOCK_COOLDOWN then return false end
    if soundKey and soundThrottle[soundKey] and now<soundThrottle[soundKey] then return false end
    local our=getRoot(LocalPlayer.Character); if not our then return false end
    if not blockReady() then return false end
    local dist=(our.Position-killerHRP.Position).Magnitude
    local effRange=S.BlockRange
    if S.HDT_Enabled and S.HDT_ExtendBlockRange then effRange=S.BlockRange+(S.HDT_MaxDistance or 15) end
    if dist>effRange then return false end
    if not isFacing(our,killerHRP) then return false end
    if not hasLineOfSight(killerHRP) then return false end
    lastBlockTime=now
    if soundKey then soundThrottle[soundKey]=now+0.5 end
    if S.AimOnBlock then
        local predicted=killerHRP.Position+killerHRP.AssemblyLinearVelocity*(S.AimPrediction or 0.06)
        aimAt(predicted)
    end
    local ok=fireBlock(killerHRP)
    if ok and S.ParryEnabled then
        task.spawn(function()
            task.wait(0.06)
            if not blockReady() then
                if os.clock()-lastParry<0.15 then return end
                lastParry=os.clock()
                if (S.PunchDelay or 0)>0 then task.wait(S.PunchDelay) end
                firePunch()
            end
        end)
    end
    return ok
end
