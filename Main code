local function aimAt(pos)
    if not pos then return end
    aimTargetPos=pos
    aimLockUntil=os.clock()+(S.AimHold or 0.35)
    if not aimConn then
        lockAutoRotate()
        aimConn=RunService.Heartbeat:Connect(function()
            if os.clock()>aimLockUntil then releaseAim() return end
            if not aimTargetPos then return end
            local c=LocalPlayer.Character; if not c then return end
            local our=c:FindFirstChild("HumanoidRootPart"); if not our then return end
            local method=S.AimMethod or "HumanoidRoot Lock"
            local smooth=math.clamp(S.AimSmoothness or 0.35,0.02,1)
            if method=="HumanoidRoot Lock" or method=="HumanoidRoot Lock + Camera Lock" then
                local flat=Vector3.new(aimTargetPos.X,our.Position.Y,aimTargetPos.Z)
                if (flat-our.Position).Magnitude>0.1 then
                    our.CFrame=our.CFrame:Lerp(CFrame.lookAt(our.Position,flat),smooth)
                end
            end
            if method=="Camera Lock" or method=="HumanoidRoot Lock + Camera Lock" then
                local cam=Workspace.CurrentCamera
                if cam then cam.CFrame=cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position,aimTargetPos),smooth) end
            end
        end)
    end
end
