-- ============================================================
-- ANIMATION TRACKING (fixed HDT foundation)
-- ============================================================
local myAnimator = nil
local myAbilityActive = false
local myAbilityId = nil
local myAbilityStartedAt = 0
local myBlockTrack = nil
local _hdtTrackCooldown = setmetatable({}, { __mode = "k" })

local function refreshMyAnimator()
    local char = LP.Character
    if not char then myAnimator = nil return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    myAnimator = hum and hum:FindFirstChildOfClass("Animator") or nil
end
task.spawn(refreshMyAnimator)
LP.CharacterAdded:Connect(function() task.wait(0.5) refreshMyAnimator() end)

-- forward decl so HDT trigger is visible to listener
local _HDT_TRIGGER

local function attachAnimListener(char)
    task.wait(0.5)
    local hum = char:WaitForChild("Humanoid", 5)
    local anim = hum and hum:WaitForChild("Animator", 5)
    if not anim then return end

    anim.AnimationPlayed:Connect(function(track)
        local animId = track.Animation and tostring(track.Animation.AnimationId):match("%d+")
        if not animId then return end

        -- Ability active (survivor abilities)
        if DB.survivorAnims[animId] then
            task.wait()
            if track.Length > 0 then
                myAbilityActive = true
                myAbilityId = animId
                myAbilityStartedAt = os.clock()
                track.Stopped:Once(function()
                    if myAbilityId == animId then
                        myAbilityActive = false
                        myAbilityId = nil
                    end
                end)
                task.delay(math.max(track.Length + 0.5, 2), function()
                    if myAbilityId == animId and os.clock() - myAbilityStartedAt >= track.Length then
                        myAbilityActive = false
                        myAbilityId = nil
                    end
                end)
            end
        end

        -- Block track (HDT trigger)
        if DB.guestBlockAnims[animId] then
            myBlockTrack = track
            if S.hitboxDrag then
                task.wait(0.05)
                if track.Length > 0 and (track.TimePosition / track.Length) < 0.75 then
                    local now = os.clock()
                    if not _hdtTrackCooldown[track] or now - _hdtTrackCooldown[track] > 0.5 then
                        _hdtTrackCooldown[track] = now
                        if _HDT_TRIGGER then task.spawn(_HDT_TRIGGER) end
                    end
                end
            end
        end
    end)
end

if LP.Character then task.spawn(attachAnimListener, LP.Character) end
LP.CharacterAdded:Connect(function(char) task.spawn(attachAnimListener, char) end)

-- Heartbeat fallback poll
RunService.Heartbeat:Connect(function()
    if not myAnimator then refreshMyAnimator() return end
    if myAbilityActive and (os.clock() - myAbilityStartedAt) > 4 then
        myAbilityActive = false
        myAbilityId = nil
    end
    if not myAbilityActive then
        for _, track in ipairs(myAnimator:GetPlayingAnimationTracks()) do
            local id = tostring(track.Animation and track.Animation.AnimationId or ""):match("%d+")
            if id and DB.survivorAnims[id] and track.Length > 0
               and (track.TimePosition / track.Length) < 0.75 then
                myAbilityActive = true
                myAbilityId = id
                myAbilityStartedAt = os.clock()
                break
            end
        end
    end
end)

_G.MSK_IsAbilityActive = function() return myAbilityActive end
_G.MSK_GetAbilityId = function() return myAbilityId end

