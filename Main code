local espTracked = setmetatable({}, { __mode = "k" })

local function cleanKillerESP(killer)
    if not killer then return end
    local tracked = espTracked[killer]
    if tracked then
        for _, inst in ipairs(tracked) do
            pcall(function() if inst and inst.Parent then inst:Destroy() end end)
        end
        espTracked[killer] = nil
    end
    for _, c in ipairs(killer:GetChildren()) do
        if c.Name:sub(1, 4) == "MSK_" then pcall(function() c:Destroy() end) end
    end
end

local function trackESP(parent, inst)
    if not inst then return end
    if not espTracked[parent] then espTracked[parent] = {} end
    table.insert(espTracked[parent], inst)
end

-- ============ Killer ESP ============
local function applyKillerESP(killer)
    if not killer or not killer.Parent then return end
    local hrp = getRoot(killer)
    local hum = getHum(killer)
    if not hrp or not hum or hum.Health <= 0 then return end

    if S.espKillerHL then
        makeHighlight(killer, "MSK_KillerHL",
            S.espKillerHLColor, S.espKillerHLColor, 0.55, 0)
    else
        clearESP(killer, "MSK_KillerHL")
    end

    if S.espKillerBB then
        local dist = hrp and LP.Character and getRoot(LP.Character)
            and math.floor((hrp.Position - getRoot(LP.Character).Position).Magnitude) or 0
        local text = killer.Name
        if S.espKillerDistance then text = text .. "\n[" .. dist .. "m]" end
        local bb = makeBillboard(hrp, "MSK_KillerBB", text, S.espKillerBBColor, 3.5)
        if bb then trackESP(killer, bb) end
    else
        clearESP(killer, "MSK_KillerBB")
        if hrp then clearESP(hrp, "MSK_KillerBB") end
    end

    if not S.espKillerHL and not S.espKillerBB then
        cleanKillerESP(killer)
    end
end

-- ============ Survivor ESP ============
local function applySurvivorESP(surv)
    if not surv or not surv.Parent then return end
    if surv == LP.Character then return end
    local hrp = getRoot(surv)
    local hum = getHum(surv)
    if not hrp or not hum or hum.Health <= 0 then return end

    if S.espSurvivorHL then
        makeHighlight(surv, "MSK_SurvivorHL",
            S.espSurvivorHLColor, S.espSurvivorHLColor, 0.6, 0)
    else
        clearESP(surv, "MSK_SurvivorHL")
    end

    if S.espSurvivorBB then
        local dist = LP.Character and getRoot(LP.Character)
            and math.floor((hrp.Position - getRoot(LP.Character).Position).Magnitude) or 0
        local text = surv.Name
        if S.espSurvivorDistance then text = text .. "\n[" .. dist .. "m]" end
        local bb = makeBillboard(hrp, "MSK_SurvivorBB", text, S.espSurvivorBBColor, 3.5)
        if bb then trackESP(surv, bb) end
    else
        clearESP(surv, "MSK_SurvivorBB")
        if hrp then clearESP(hrp, "MSK_SurvivorBB") end
    end

    if S.espSurvivorHealth then
        local bb = makeHealthBar(hrp)
        if bb then trackESP(surv, bb) end
    else
        if hrp then clearESP(hrp, "MSK_HealthBar") end
    end
end

-- ============ Generator ESP ============
local function applyGenESP(gen)
    if not gen or not gen.Parent then return end
    if gen.Name ~= "Generator" and gen.Name ~= "FakeGenerator" then return end
    if not S.espGen then
        clearESP(gen, "MSK_GenHL")
        return
    end

    local color = S.espGenColor
    if gen.Name == "FakeGenerator" then
        color = S.espGenFakeColor
    else
        local prog = gen:FindFirstChild("Progress")
        if prog and prog:IsA("NumberValue") and prog.Value >= 100 then
            color = S.espGenDoneColor
        end
    end

    makeHighlight(gen, "MSK_GenHL", color, color, 0.6, 0)

    if S.espGenProgress and gen.Name ~= "FakeGenerator" then
        local prog = gen:FindFirstChild("Progress")
        if prog then
            local main = gen:FindFirstChild("Main") or gen:FindFirstChild("Base") or gen.PrimaryPart
            if main then
                local txt = "Gen (" .. math.floor(prog.Value) .. "%)"
                local bb, label = makeBillboard(main, "MSK_GenBB", txt, color, 4)
                if bb then
                    label.Name = "ProgressText"
                    task.spawn(function()
                        while bb.Parent and S.espGen do
                            if prog.Parent then
                                label.Text = "Gen (" .. math.floor(prog.Value) .. "%)"
                            end
                            task.wait(0.3)
                        end
                    end)
                end
            end
        end
    else
        local main = gen:FindFirstChild("Main") or gen.PrimaryPart
        if main then clearESP(main, "MSK_GenBB") end
    end
end

