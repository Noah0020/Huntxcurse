local PING_ABILITIES = { AimGun = true, GunFire = true, GunExplode = true, GunFail = true }

local function getPing()
    local ok, v = pcall(function() return lp:GetNetworkPing() end)
    if ok and type(v) == "number" then return v end
    ok, v = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000 end)
    if ok and type(v) == "number" then return v end
    return 0
end

local function getMyRole()
    local c = lp.Character
    local p = c and c.Parent
    if p and (p.Name == "Survivors" or p.Name == "Killers") then return p.Name end
    return nil
end

local function isPlayingSurvivor()
    if getMyRole() ~= "Survivors" then return false end
    local char = lp.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    return true
end

local function updateCachedTarget()
    local myRoot = getRoot(lp.Character)
    if not myRoot or not KillersFolder then AIM.CachedTargetHRP = nil return end
    local best, bestD = nil, 500
    for _, s in ipairs(KillersFolder:GetChildren()) do
        if s:IsA("Model") and s ~= lp.Character then
            local hrp = s:FindFirstChild("HumanoidRootPart")
            local hum = s:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local d = (hrp.Position - myRoot.Position).Magnitude
                if d < bestD then bestD = d; best = hrp end
            end
        end
    end
    AIM.CachedTargetHRP = best
end

task.spawn(function()
    while true do
        task.wait(0.05)
        pcall(updateCachedTarget)
    end
end)

local function isPingAbility(abilityName)
    return abilityName and PING_ABILITIES[abilityName] == true
end

local function predictHRP(hrp)
    if not hrp then return nil end
    if AIM.PredictMode == "Off" then return hrp.Position end
    local vel = hrp.AssemblyLinearVelocity or Vector3.new()
    if vel.Magnitude > 200 then vel = Vector3.zero end
    local usePing = isPingAbility(AIM.CurrentAbility)
    local velLead  = 0
    local pingLead = 0
    if AIM.PredictMode == "Velocity" or AIM.PredictMode == "Both" then
        velLead = AIM.PredictLead
    end
    if usePing and (AIM.PredictMode == "Ping" or AIM.PredictMode == "Both") then
        local ping = getPing() * 0.5 * AIM.PingMult
        pingLead = math.clamp(ping, 0, 0.5)
    end
    local totalLead = math.clamp(velLead + pingLead, 0, 0.75)
    return hrp.Position + vel * totalLead
end

local function applyAim(targetPos)
    if not targetPos then return end
    local smooth = AIM.Smooth
    local mode = AIM.AimMode
    if mode == "Camera" or mode == "HRP+Camera" then
        Camera.CFrame = Camera.CFrame:Lerp(
            CFrame.lookAt(Camera.CFrame.Position, targetPos), smooth)
    end
    if mode == "HRP" or mode == "HRP+Camera" then
        local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        if myRoot then
            local flat = Vector3.new(targetPos.X, myRoot.Position.Y, targetPos.Z)
            if (flat - myRoot.Position).Magnitude > 0.1 then
                myRoot.CFrame = myRoot.CFrame:Lerp(
                    CFrame.lookAt(myRoot.Position, flat), smooth)
            end
        end
    end
end

function AIM.ForceAimNow(duration, abilityName)
    AIM._forceUntil = tick() + (duration or 1.0)
    if abilityName then AIM.CurrentAbility = abilityName end
end

RunService.RenderStepped:Connect(function()
    if not isPlayingSurvivor() then return end
    if not AIM.CachedTargetHRP or not AIM.CachedTargetHRP.Parent then return end

    local forced = tick() < (AIM._forceUntil or 0)
    local active = forced or (AIM.Enabled and AIM.ForceAim)
    if not active then
        AIM.CurrentAbility = nil
        return
    end

    local targetPos = predictHRP(AIM.CachedTargetHRP)
    if not targetPos then return end

    if forced then
        local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        if myRoot then
            myRoot.AssemblyAngularVelocity = Vector3.zero
            local flat = Vector3.new(targetPos.X, myRoot.Position.Y, targetPos.Z)
            if (flat - myRoot.Position).Magnitude > 0.05 then
                local cf = CFrame.lookAt(myRoot.Position, flat)
                myRoot.CFrame = cf
                myRoot.CFrame = cf
                myRoot.CFrame = cf
                myRoot.CFrame = cf
            end
        end
        pcall(function()
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetPos)
        end)
    else
        applyAim(targetPos)
    end
end)

