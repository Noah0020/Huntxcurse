local function clearESP(parent, tag)
    if not parent then return end
    for _, c in ipairs(parent:GetChildren()) do
        if c.Name == tag or (c:GetAttribute and c:GetAttribute("MSK_ESP")) then
            pcall(function() c:Destroy() end)
        end
    end
end

local function makeHighlight(parent, name, fill, outline, fillT, outlineT)
    if not parent or not parent.Parent then return nil end
    local existing = parent:FindFirstChild(name)
    if existing then existing:Destroy() end
    local hl = Instance.new("Highlight")
    hl.Name = name
    hl.Adornee = parent
    hl.FillColor = fill or Color3.new(1, 0, 0)
    hl.OutlineColor = outline or fill or Color3.new(1, 0, 0)
    hl.FillTransparency = fillT or 0.6
    hl.OutlineTransparency = outlineT or 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl:SetAttribute("MSK_ESP", true)
    hl.Parent = parent
    return hl
end

local function makeBillboard(parent, name, text, color, offsetY)
    if not parent or not parent.Parent then return nil end
    local existing = parent:FindFirstChild(name)
    if existing then existing:Destroy() end
    local bb = Instance.new("BillboardGui")
    bb.Name = name
    bb.Size = UDim2.new(0, 120, 0, 40)
    bb.StudsOffsetWorldSpace = Vector3.new(0, offsetY or 3, 0)
    bb.AlwaysOnTop = true
    bb.MaxDistance = 500
    bb.LightInfluence = 0
    bb:SetAttribute("MSK_ESP", true)
    bb.Adornee = parent
    bb.Parent = parent

    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.TextColor3 = color or Color3.new(1, 1, 1)
    txt.TextStrokeTransparency = 0.3
    txt.TextStrokeColor3 = Color3.new(0, 0, 0)
    txt.TextScaled = true
    txt.Font = Enum.Font.GothamBold
    txt.Text = text or ""
    txt.Parent = bb

    return bb, txt
end

local function makeHealthBar(parent)
    if not parent or not parent.Parent then return nil end
