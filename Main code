local function destroyVisualsFor(killer)
    if rangeVisuals[killer] then pcall(function() rangeVisuals[killer]:Destroy() end); rangeVisuals[killer]=nil end
    if coneVisuals[killer] then pcall(function() coneVisuals[killer]:Destroy() end); coneVisuals[killer]=nil end
end
local function clearAllVisuals()
    for k in pairs(rangeVisuals) do destroyVisualsFor(k) end
    for k in pairs(coneVisuals) do destroyVisualsFor(k) end
end
local function visualTick()
    local folder=getKillersFolder(); if not folder then return end
    local char=LocalPlayer.Character
    local myRoot=char and char:FindFirstChild("HumanoidRootPart")
    for _,killer in ipairs(folder:GetChildren()) do
        if killer:IsA("Model") then
            local hrp=killer:FindFirstChild("HumanoidRootPart")
            if hrp then
                local yOffset=-(hrp.Size.Y/2+0.05)
                local inR=myRoot and (hrp.Position-myRoot.Position).Magnitude<=S.BlockRange
                local facing=myRoot and isFacing(myRoot,hrp) or false
                if S.ShowRangeCircle then
                    local a=rangeVisuals[killer]
                    if not a or a.Parent~=hrp then
                        if a then a:Destroy() end
                        a=makeAdornment(hrp,Color3.fromRGB(255,255,0),yOffset)
                        rangeVisuals[killer]=a
                    end
                    a.Radius=S.BlockRange
                    a.CFrame=CFrame.new(0,yOffset,0)*CFrame.Angles(math.rad(90),0,0)
                    a.Color3=(inR and facing) and Color3.fromRGB(0,255,120)
                        or inR and Color3.fromRGB(255,165,0) or Color3.fromRGB(255,255,0)
                elseif rangeVisuals[killer] then rangeVisuals[killer]:Destroy(); rangeVisuals[killer]=nil end
                if S.ShowBlockCone then
                    local a=coneVisuals[killer]
                    if not a or a.Parent~=hrp then
                        if a then a:Destroy() end
                        a=makeAdornment(hrp,Color3.fromRGB(255,0,0),yOffset)
                        coneVisuals[killer]=a
                    end
                    local dot=math.clamp(S.FacingDot or 0.3,-1,1)
                    local frac=math.acos(dot)/math.pi
                    local radius=math.max(1,S.BlockRange*(0.20+0.80*frac))
                    local forwardDist=S.BlockRange*0.35
                    a.Radius=radius
                    local kl=hrp.CFrame.LookVector
                    local flat=Vector3.new(kl.X,0,kl.Z)
                    if flat.Magnitude<0.01 then flat=Vector3.new(0,0,-1) end
                    flat=flat.Unit
                    local cf=CFrame.lookAt(hrp.Position,hrp.Position+flat)
                    a.CFrame=cf*CFrame.new(0,yOffset,-forwardDist)*CFrame.Angles(math.rad(90),0,0)
                    a.Color3=(inR and facing) and Color3.fromRGB(0,255,120)
                        or facing and Color3.fromRGB(255,165,0) or Color3.fromRGB(255,0,0)
                elseif coneVisuals[killer] then coneVisuals[killer]:Destroy(); coneVisuals[killer]=nil end
            end
        end
    end
end
