local DB = {
    killerAnims = {}, survivorAnims = {}, chaseSounds = {},
    shedStun = {}, guestStun = {}, janeStun = {}, twoTimeStun = {}, chanceStun = {},
    guestPunchAnims = {}, guestBlockAnims = {}, autoBlockSounds = {},
}
local BAD_SOUNDS = { ["112809109188560"] = true }

local function loadDB()
    local ok, body = pcall(function()
        return game:HttpGet("https://gist.githubusercontent.com/zxcursedsocute/4e0833a7a6cfdc537844b7545dd9079e/raw/gistfile1.json")
    end)
    if not ok or not body or #body < 100 then
        warn("[Meowsaken] Gist fetch failed")
        return false
    end
    local ok2, data = pcall(function() return HttpService:JSONDecode(body) end)
    if not ok2 or type(data) ~= "table" then
        warn("[Meowsaken] Gist decode failed")
        return false
    end
    local function merge(dst, src)
        if type(src) ~= "table" then return end
        for k, v in pairs(src) do if v then dst[tostring(k)] = true end end
    end
    merge(DB.killerAnims,     data.a)
    merge(DB.survivorAnims,   data.b)
    merge(DB.chaseSounds,     data.c)
    if type(data.d) == "table" then
        merge(DB.shedStun,     data.d.a)
        merge(DB.guestStun,    data.d.b)
        merge(DB.janeStun,     data.d.c)
        merge(DB.twoTimeStun,  data.d.d)
        merge(DB.chanceStun,   data.d.e)
    end
    merge(DB.guestPunchAnims, data.e)
    merge(DB.guestBlockAnims, data.f)
    merge(DB.autoBlockSounds, data.g)
    local function count(t) local n=0 for _ in pairs(t) do n=n+1 end return n end
    print(string.format(
        "[Meowsaken] DB loaded: kill=%d surv=%d blkAnim=%d M1Snd=%d chase=%d",
        count(DB.killerAnims), count(DB.survivorAnims),
        count(DB.guestBlockAnims), count(DB.autoBlockSounds),
        count(DB.chaseSounds)
    ))
    return true
end
loadDB()

