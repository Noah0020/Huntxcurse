local m1Last = 0
RunService.Heartbeat:Connect(function()
    if S.role ~= "Killers" then return end

    if S.autoM1 then
        local now = os.clock()
        if now - m1Last > 1.5 then
            local char = LP.Character
            local myRoot = char and getRoot(char)
            if myRoot then
                local best, bestD = nil, S.autoM1Dist
                for _, sv in ipairs(getSurvivors()) do
                    local hrp = getRoot(sv)
                    local hum = getHum(sv)
                    if hrp and hum and hum.Health > 0 then
                        local d = (hrp.Position - myRoot.Position).Magnitude
                        if d < bestD then
                            if not S.autoM1Facing or myRoot.CFrame.LookVector:Dot((hrp.Position - myRoot.Position).Unit) > 0.4 then
                                best, bestD = sv, d
                            end
                        end
                    end
                end
                if best then
                    m1Last = now
                    local re = ReplicatedStorage:FindFirstChild("Modules")
                        and ReplicatedStorage.Modules:FindFirstChild("Network")
                        and ReplicatedStorage.Modules.Network:FindFirstChild("Network")
                        and ReplicatedStorage.Modules.Network.Network:FindFirstChild("RemoteEvent")
                    if re then
                        local ability = char.Name == "Noli" and "Stab"
                            or char.Name == "c00lkidd" and "Punch"
                            or char.Name == "Sixer" and "Carving Slash"
                            or "Slash"
                        local bytes = {3, 5, 0, 0, 0}
                        for i = 1, #ability do bytes[#bytes+1] = string.byte(ability, i) end
                        if CAP.buffer then
                            local b = buffer.create(#bytes)
                            for i = 1, #bytes do buffer.writeu8(b, i-1, bytes[i]) end
                            pcall(function() re:FireServer("UseActorAbility", { b }) end)
                        else
                            local s = ""
                            for i = 1, #bytes do s = s .. string.char(bytes[i]) end
                            pcall(function() re:FireServer("UseActorAbility", { s }) end)
                        end
                    end
                end
            end
        end
    end

    if S.autoRagingPace or S.auto404 then
        local char = LP.Character
        if char and (char.Name == "Slasher" or char.Name == "JohnDoe") then
            local myRoot = getRoot(char)
            if myRoot then
                for _, sv in ipairs(getSurvivors()) do
                    local hrp = getRoot(sv)
                    if hrp and (hrp.Position - myRoot.Position).Magnitude <= S.ragingPaceDist then
                        local ability = char.Name == "Slasher" and "RagingPace" or "404Error"
                        local re = ReplicatedStorage:FindFirstChild("Modules")
                            and ReplicatedStorage.Modules:FindFirstChild("Network")
                            and ReplicatedStorage.Modules.Network:FindFirstChild("Network")
                            and ReplicatedStorage.Modules.Network.Network:FindFirstChild("RemoteEvent")
                        if re then
                            local bytes = {3, 5, 0, 0, 0}
                            for i = 1, #ability do bytes[#bytes+1] = string.byte(ability, i) end
                            if CAP.buffer then
                                local b = buffer.create(#bytes)
                                for i = 1, #bytes do buffer.writeu8(b, i-1, bytes[i]) end
                                pcall(function() re:FireServer("UseActorAbility", { b }) end)
                            end
                        end
                        break
                    end
                end
            end
        end
    end
end)

