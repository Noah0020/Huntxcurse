local function installSilent()
    if S.silentHooked then return true end
    if not CAP.hookfunction then
        notify("Silent Aim", "hookfunction unavailable")
        return false
    end

    local ok, mod = pcall(function()
        return require(ReplicatedStorage.Systems.Player.Miscellaneous.GetPlayerMousePosition)
    end)
    if not ok or type(mod) ~= "table" or type(mod.GetMousePos) ~= "function" then
        notify("Silent Aim", "Module not found")
        warn("[Meowsaken] SilentAim: module missing")
        return false
    end

    S.silentGetMousePosOld = mod.GetMousePos
    local function newFunc(...)
        if S.silentAim then
            local aimKey, predictTime = getMyAimConfig()
            if aimKey and S[aimKey] and _G.MSK_IsAbilityActive() then
                local killer = findClosestKiller()
                if killer then
                    local killerRoot = getRoot(killer)
                    if killerRoot then
                        local vel = killerRoot.AssemblyLinearVelocity
                        local targetPos = killerRoot.Position + vel * (predictTime or S.silentLead)
                        pcall(function()
                            targetPos += vel * (LP:GetNetworkPing() * 0.5)
                        end)
                        return targetPos
                    end
                end
            end
        end
        return S.silentGetMousePosOld(...)
    end

    local ok2, err = pcall(function()
        hookfunction(S.silentGetMousePosOld, newFunc)
    end)
    if not ok2 then
        notify("Silent Aim", "Hook failed: " .. tostring(err))
        warn("[Meowsaken] SilentAim hook error: " .. tostring(err))
        return false
    end
    S.silentHooked = true
    print("[Meowsaken] SilentAim installed")
    return true
end

local function uninstallSilent()
    if not S.silentHooked or not S.silentGetMousePosOld then return end
    pcall(function()
        local mod = require(ReplicatedStorage.Systems.Player.Miscellaneous.GetPlayerMousePosition)
        if CAP.hookfunction then hookfunction(mod.GetMousePos, S.silentGetMousePosOld) end
    end)
    S.silentHooked = false
end

