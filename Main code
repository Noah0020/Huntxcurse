        if inst.Name == "Medkit" and S.espMedkit then
            applyItemESP(inst, "Medkit", S.espMedkitColor)
        elseif inst.Name == "BloxyCola" and S.espBloxy then
            applyItemESP(inst, "Bloxy", S.espBloxyColor)
        end
    end
end

