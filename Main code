            local main=obj:FindFirstChild("Main")
            if main and (main.Position-r.Position).Magnitude<6.7 then
                task.spawn(function()
                    isFixingGen=true
                    local rem=obj:FindFirstChild("Remotes")
                    local re=rem and rem:FindFirstChildOfClass("RemoteEvent")
                    if re and PlayerGui:FindFirstChild("PuzzleUI") then
                        while S.AutoGen do
                            if not PlayerGui:FindFirstChild("PuzzleUI") then break end
                            local near=isPlayersNear(32)
                            local cd=S.GenCooldown or 4
                            if S.GenSpeedUpNear and not near then cd=1.5 end
                            task.wait(cd*(1+(math.random()*0.2-0.1)))
