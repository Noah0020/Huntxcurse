local aimLastTick = 0
local AIM_TICK = 0.016

local function getMyAimConfig()
    local c = LP.Character
    if not c then return nil end
    local name = c:GetAttribute("CharacterName") or c.Name
    if name == "Guest1337" then return "aimGuest", S.predGuest end
    if name == "Chance"     then return "aimChance", S.predChance end
    if name == "JaneDoe"    then return "aimJaneCrystal", S.predJaneCrystal end
    if name == "Dusekkar"   then return "aimDusekkar", S.predDusekkar end
    if name == "TwoTime" or name == "Two Time"
                            then return "aimTwoTime", S.predTwoTime end
    if name == "Shedletsky" then return "aimShedletsky", S.predShedletsky end
    if name == "Veeronica"  then return "aimVeeronica", S.predVeeronica end
    if name == "Elliot"     then return "aimPizza", S.predPizza end
    return nil
end

local function findClosestKiller()
    local myRoot = getRoot(LP.Character)
    if not myRoot then return nil end
    local closest, closestDist = nil, S.aimMaxDist
    for _, killer in ipairs(getKillers()) do
        local hrp = getRoot(killer)
        local hum = getHum(killer)
        if hrp and hum and hum.Health > 0 then
            local d = (hrp.Position - myRoot.Position).Magnitude
            if d < closestDist then closest, closestDist = killer, d end
        end
    end
    return closest
end

local function hasLOS(targetPart)
    if not S.aimWallCheck then return true end
    local myChar = LP.Character
    local myRoot = getRoot(myChar)
    if not myRoot or not targetPart then return true end
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = { myChar, targetPart.Parent }
    rp.IgnoreWater = true
    return Workspace:Raycast(myRoot.Position, targetPart.Position - myRoot.Position, rp) == nil
end

local function applyAim(targetPos, smoothness, method)
    local myChar = LP.Character
    local myRoot = getRoot(myChar)
    if not myRoot then return end
    smoothness = smoothness or S.aimSmoothness
    method = method or S.aimMethod
    if method:find("HumanoidRoot") or method:find("HRP") then
        local flat = Vector3.new(targetPos.X, myRoot.Position.Y, targetPos.Z)
        if (flat - myRoot.Position).Magnitude > 0.1 then
            myRoot.CFrame = myRoot.CFrame:Lerp(CFrame.lookAt(myRoot.Position, flat), smoothness)
        end
    end
    if method:find("Camera") then
        Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, targetPos), smoothness)
    end
end

RunService.RenderStepped:Connect(function(dt)
    local now = os.clock()
    if now - aimLastTick < AIM_TICK then return end
    aimLastTick = now

    -- Survivor aim (ability-gated)
    local aimKey, predictTime = getMyAimConfig()
    if aimKey and S[aimKey] then
        local gated = S.aimOnlyOnAbility and not _G.MSK_IsAbilityActive()
        if not gated then
            local killer = findClosestKiller()
            if killer then
                local killerRoot = getRoot(killer)
                if killerRoot and hasLOS(killerRoot) then
                    local vel = killerRoot.AssemblyLinearVelocity
                    local targetPos = killerRoot.Position + vel * predictTime
                    if S.aimPart == "Head" then
                        local head = killer:FindFirstChild("Head")
                        if head then targetPos = head.Position + vel * predictTime end
                    end
                    applyAim(targetPos)
                end
            end
        end
    end

    -- Aim on Attack (killer): target survivors
    if S.aimOnAttack and S.role == "Killers" then
        if _G.MSK_IsAbilityActive() then
            local myRoot = getRoot(LP.Character)
            if myRoot then
                local best, bestD = nil, S.aimOnAttackDist
                for _, sv in ipairs(getSurvivors()) do
                    local hrp = getRoot(sv)
                    local hum = getHum(sv)
                    if hrp and hum and hum.Health > 0 then
                        local d = (hrp.Position - myRoot.Position).Magnitude
                        if d < bestD then best, bestD = sv, d end
                    end
                end
                if best then
                    local hrp = getRoot(best)
                    if hrp and hasLOS(hrp) then
                        local vel = hrp.AssemblyLinearVelocity
                        local targetPos = hrp.Position + vel * S.aimOnAttackPred
                        applyAim(targetPos, S.aimOnAttackSmooth, S.aimOnAttackMethod)
                    end
                end
            end
        end
    end
end)

