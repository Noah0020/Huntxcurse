local function isFacing(myRoot,targetHRP)
    if not myRoot or not targetHRP then return false end
    local d=myRoot.Position-targetHRP.Position; local mag=d.Magnitude
    if mag<3 or mag<1e-4 then return true end
    local lv=targetHRP.CFrame.LookVector
    if lv.Magnitude<1e-4 then return true end
    return lv:Dot(d/mag)>(S.FacingDot or 0.3)
end
