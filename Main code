local antiBaitOld = nil
local antiBaitInstalled = false
local uninstallAntiBait

local function installAntiBait()
    if antiBaitInstalled then uninstallAntiBait(); task.wait(0.1) end
    if not CAP.hookfunction then
        notify("Anti Bait", "hookfunction unavailable")
        return
    end
    local ok, netMod = pcall(function()
        return require(ReplicatedStorage.Modules.Network.Network)
    end)
    if not ok or not netMod then
        notify("Anti Bait", "Network module missing")
        return
    end
    local ok2, charRep = pcall(function()
        return require(ReplicatedStorage.Systems.Player.Game.CharacterReplication)
    end)
    if not ok2 or not charRep then
        notify("Anti Bait", "CharacterReplication missing")
        return
    end
    antiBaitOld = netMod.FireServerConnection
    local function newFunc(self, connName, eventType, ...)
        local args = {...}
        if S.antiBait and connName == "UpdateCharacterPosition" then
            local char = LP.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local killer = findClosestKiller()
            if killer and hrp then
                local khrp = getRoot(killer)
                if khrp then
                    local behind = khrp.CFrame * CFrame.new(0, 0, S.antiBaitBehind)
                    local stepped = hrp.CFrame:Lerp(behind, math.clamp(S.antiBaitSpeed / 60, 0, 1))
                    args[1] = charRep.Serialize(stepped, hrp.AssemblyLinearVelocity)
                end
            end
        end
        if antiBaitOld then
            return antiBaitOld(self, connName, eventType, unpack(args))
        end
    end
    local ok3, err = pcall(function()
        hookfunction(antiBaitOld, newFunc)
    end)
    if not ok3 then
        notify("Anti Bait", "Hook failed: " .. tostring(err))
        return
    end
    antiBaitInstalled = true
    print("[Meowsaken] AntiBait installed")
end

uninstallAntiBait = function()
    if not antiBaitInstalled or not antiBaitOld then return end
    pcall(function()
        local netMod = require(ReplicatedStorage.Modules.Network.Network)
        if CAP.hookfunction then hookfunction(netMod.FireServerConnection, antiBaitOld) end
    end)
    antiBaitInstalled = false
end

