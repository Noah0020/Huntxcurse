local function handleDKW(active)
    local mp=getGameMap(); if not mp then return end
    local d=mp:FindFirstChild("KillerDoors",true) or mp:FindFirstChild("Killer Doors",true)
    local c=mp:FindFirstChild("KillerOnly",true)
