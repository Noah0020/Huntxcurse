-- HDT TRIGGER (assign to forward decl)
-- ============================================================
local _hdtDebounce = false
local function getNearestKillerModel(maxDist)
    maxDist = maxDist or S.hdtRange
    local myRoot = getRoot(LP.Character)
    if not myRoot then return nil end
    local best, bestD = nil, maxDist
    for _, k in ipairs(getKillers()) do
        local hrp = getRoot(k)
        local hum = getHum(k)
        if hrp and hum and hum.Health > 0 then
            local d = (hrp.Position - myRoot.Position).Magnitude
            if d < bestD then bestD, best = d, k end
        end
    end
    return best
end

local function beginDrag(killerModel)
    if _hdtDebounce then return end
    if not killerModel or not killerModel.Parent then return end

    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    local targetHRP = getRoot(killerModel)
    if not targetHRP then return end

    _hdtDebounce = true

    local oldWalk = hum.WalkSpeed
    local oldJump = hum.JumpPower
    local oldPlatform = hum.PlatformStand

    hum.WalkSpeed = 0
    hum.JumpPower = 0
    hum.PlatformStand = false

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e5, 0, 1e5)
    bv.Velocity = Vector3.zero
    bv.Parent = hrp

    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not _hdtDebounce then
            if conn then conn:Disconnect() end
            if bv and bv.Parent then bv:Destroy() end
            if hum and hum.Parent then
                hum.WalkSpeed = oldWalk
                hum.JumpPower = oldJump
                hum.PlatformStand = oldPlatform
            end
            return
        end
        if not killerModel.Parent then _hdtDebounce = false return end
        local tHRP = getRoot(killerModel)
        if not tHRP then _hdtDebounce = false return end
        local toTarget = tHRP.Position - hrp.Position
        local horiz = Vector3.new(toTarget.X, 0, toTarget.Z)
        if horiz.Magnitude > 0.01 then
            bv.Velocity = horiz.Unit * S.hdtSpeed
        end
        if toTarget.Magnitude <= 2 then _hdtDebounce = false end
    end)

    task.delay(S.hdtTimeout or 0.4, function() _hdtDebounce = false end)
end

_HDT_TRIGGER = function()
    task.wait(S.hdtDelay or 0)
    local nearest = getNearestKillerModel(S.hdtRange)
    if nearest then beginDrag(nearest) end
end

